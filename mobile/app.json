{
  "expo": {
    "name": "VibePick",
    "slug": "vibepick",
    "version": "0.1.0",
    "scheme": "vibepick",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#09090F",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.vibepick.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "VibePick reads photos and videos you choose so it can suggest songs that match them."
      }
    },
    "android": {
      "package": "app.vibepick.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#9333EA"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsMovieWithMaxCount": 1
          },
          "androidIntentFilters": [
            "image/*",
            "video/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*"
          ]
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#09090F"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://vibepick.duckdns.org"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
