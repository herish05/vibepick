NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://vibepick:vibepick@localhost:5432/vibepick
REDIS_URL=redis://localhost:6379

# Auth. Generate: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Media storage (local driver; S3-compatible driver is a documented extension point)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
MEDIA_RETENTION_DAYS=30
# Secret used to sign media URLs
MEDIA_URL_SECRET=change-me-media-secret-change-me-media

# ML service
ML_SERVICE_URL=http://localhost:8000
AI_PROVIDER=heuristic
AI_API_KEY=

# Optional Instagram official OAuth (leave empty to disable)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=

CORS_ORIGINS=*
POSTGRES_PASSWORD=vibepick
AUTH_RATE_LIMIT_MAX=10
